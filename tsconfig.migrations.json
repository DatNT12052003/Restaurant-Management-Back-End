{
    // Giai đoạn 14: biên dịch migration sang JS cho image production (không cần tsx khi chạy migrate)
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "rootDir": ".",
        "outDir": "./dist/migrate",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true
    },
    "include": ["migrations"]
}
