{
    "name": "restaurant-management-backend",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "vitest run",
        "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
        "build": "tsc",
        "build:migrations": "tsc -p tsconfig.migrations.json",
        "start": "node -r ./scripts/register-paths.js dist/server.js",
        "migrate": "node-pg-migrate",
        "migrate:up": "tsx node_modules/node-pg-migrate/bin/node-pg-migrate up",
        "migrate:down": "tsx node_modules/node-pg-migrate/bin/node-pg-migrate down",
        "migrate:create": "tsx node_modules/node-pg-migrate/bin/node-pg-migrate create --migration-file-language ts",
        "migrate:prod": "node-pg-migrate up -m dist/migrate/migrations",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@sentry/node": "^11.11.0",
        "bcrypt": "^6.0.0",
        "cloudinary": "^1.41.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.1",
        "express": "^5.2.1",
        "express-rate-limit": "^7.5.1",
        "i18next": "^26.0.5",
        "i18next-fs-backend": "^2.6.3",
        "i18next-http-middleware": "^3.9.2",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "multer": "^2.1.1",
        "multer-storage-cloudinary": "^4.0.0",
        "node-pg-migrate": "^8.0.4",
        "nodemailer": "^8.0.6",
        "pg": "^8.20.0",
        "qs": "^6.15.1",
        "socket.io": "^4.8.3",
        "streamifier": "^0.1.1",
        "tsconfig-paths": "^4.2.0",
        "uuid": "^14.0.0",
        "winston": "^3.19.0",
        "winston-transport": "^4.9.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.6.0",
        "@types/nodemailer": "^8.0.0",
        "@types/pg": "^8.20.0",
        "@types/socket.io": "^3.0.1",
        "@types/streamifier": "^0.1.2",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^10.0.0",
        "eslint": "^10.2.1",
        "globals": "^17.5.0",
        "prettier": "^3.6.2",
        "supertest": "^7.1.4",
        "ts-node-dev": "^2.0.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.2",
        "vitest": "^3.2.4"
    }
}
