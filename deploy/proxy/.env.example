# Giai đoạn 14: sao chép thành proxy/.env trên máy chủ
PROD_DOMAIN=example.com
STAGING_DOMAIN=staging.example.com
# Email nhận thông báo chứng chỉ của Let's Encrypt
ACME_EMAIL=admin@example.com
# Mật khẩu vào staging: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext '<mật khẩu>'
# Chuỗi băm có ký tự $: viết mỗi $ thành $$ trong file này (compose coi $ là biến)
STAGING_USER=staging
STAGING_PASSWORD_HASH=
