# Giai đoạn 14: biến của compose cho MỘT môi trường. Sao chép thành <môi trường>/.env trên máy chủ,
# ví dụ /opt/restaurant/production/.env và /opt/restaurant/staging/.env (mỗi môi trường DB riêng).

# Tên project compose; web có alias "<STACK_NAME>-web" trên mạng edge để Caddy trỏ tới
STACK_NAME=rm-production
# production | staging (cũng là tên thư mục chứa backend.env)
APP_ENV=production

# Image do GitHub Actions build (GHCR, chữ thường). Tag do deploy.sh ghi vào versions.env
BACKEND_IMAGE=ghcr.io/<github-owner>/restaurant-management-backend
WEB_IMAGE=ghcr.io/<github-owner>/restaurant-management-web
BACKEND_TAG=latest
WEB_TAG=latest

# PostgreSQL của môi trường này
DB_USER=restaurant
DB_PASSWORD=<đổi-mật-khẩu-mạnh>
DB_NAME=restaurant_management

# Tài khoản admin đầu tiên (chỉ tạo khi DB chưa có admin). Xóa sau lần triển khai đầu.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Sao lưu: giờ chạy hằng ngày (giờ VN), ngày kiểm tra phục hồi (1 = thứ Hai ... 7 = Chủ nhật), số bản giữ lại
BACKUP_DIR=./production/backups
BACKUP_TIME=02:30
BACKUP_VERIFY_WEEKDAY=7
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
