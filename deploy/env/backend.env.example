# Giai đoạn 14: biến môi trường của backend cho MỘT môi trường. Sao chép thành <môi trường>/backend.env.
# DB_*, APP_ENV, TRUST_PROXY, LOG_TO_FILE do docker-compose.yml đặt sẵn.

NODE_ENV=production
PORT=3000

# Tên miền của môi trường (web và API cùng tên miền, API ở /api)
CORS_ORIGINS=https://example.com
PUBLIC_WEB_URL=https://example.com

# Bí mật JWT: chuỗi ngẫu nhiên dài, KHÁC NHAU giữa production và staging (openssl rand -hex 48)
ACCESS_SECRET=
REFRESH_SECRET=
RESET_PASSWORD_SECRET=

# Cloudinary (ảnh), Gmail (OTP, email đặt bàn)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=

# Chuyển khoản VietQR + webhook SePay. Webhook URL trên SePay: https://<tên miền>/api/payment-gateway/webhooks/sepay
# Kiểu xác thực "API Key", giá trị trùng biến dưới. Để trống = tắt webhook (vẫn xác nhận tay được).
SEPAY_WEBHOOK_API_KEY=
# Tiền tố mã đối soát trong nội dung chuyển khoản (chữ in hoa, số). Nên khác nhau giữa production và staging.
PAYMENT_REF_PREFIX=RMP

# Hóa đơn điện tử: mock (giả lập) cho tới khi ký hợp đồng với nhà cung cấp
EINVOICE_PROVIDER=mock

# Giám sát lỗi (Sentry hoặc GlitchTip). Để trống = tắt
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=info

# Tắt giới hạn tần suất (chỉ dùng khi kiểm thử tải trên staging)
RATE_LIMIT_DISABLED=false
